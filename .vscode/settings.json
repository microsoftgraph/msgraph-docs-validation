{
  "cSpell.words": [
    "apipagetype",
    "conceptualpagetype",
    "msrc",
    "nocase",
    "onmicrosoft",
    "resourcepagetype"
  ],
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/objects",
    ".vscode",
    ".vscode-insiders",
    "test/testData"
  ],
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}",
    "!**/bower_components",
    "!**/node_modules",
    "!**/vendor",
    "!**/.git",
    "!**/testData"
  ]
}
